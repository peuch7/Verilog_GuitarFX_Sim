{
  "name": "VerilogSim",
  "build": {
    "context": "..",
    "dockerfile": "../docker/Dockerfile"
  },
  "workspaceFolder": "/work",
  "workspaceMount": "source=${localWorkspaceFolder},target=/work,type=bind,consistency=cached",
  "mounts": [
    "source=wavsim-build,target=/work/build,type=volume",
    // Hide the host's .venv: a macOS or Windows virtualenv is visible through
    // the bind mount but its interpreter cannot run in the container.
    "target=/work/.venv,type=volume"
  ],
  "postCreateCommand": "python3 scripts/doctor.py",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "mshr-h.veriloghdl"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "python.analysis.extraPaths": ["/work/tools"],
        "files.eol": "\n"
      }
    }
  }
}
