# Keep LF endings everywhere. Windows members run the toolchain inside a Linux
# container; a CRLF checkout silently breaks shell scripts and Makefiles there.
* text=auto eol=lf

*.sh      text eol=lf
*.py      text eol=lf
*.sv      text eol=lf
*.svh     text eol=lf
*.cpp     text eol=lf
*.h       text eol=lf
*.json    text eol=lf
*.md      text eol=lf
Makefile  text eol=lf

# PowerShell is the one place Windows line endings are correct.
*.ps1     text eol=crlf

# Never touch binaries.
*.wav     binary
*.pcm24   binary
*.png     binary
