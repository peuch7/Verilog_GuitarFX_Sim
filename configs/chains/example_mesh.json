{
  "name": "example_mesh",
  "description": "Overdrive into delay into reverb - one board per stage, in the order a pedalboard would use.",
  "stages": [
    {
      "effect": "overdrive",
      "params": { "drive": 8, "tone": 0.55, "level": 0.7 }
    },
    {
      "effect": "delay",
      "params": { "delay_samples": 14400, "feedback": 0.35, "mix": 0.3 }
    },
    {
      "effect": "reverb",
      "params": { "decay": 0.75, "damping": 0.4, "mix": 0.25 }
    }
  ]
}
